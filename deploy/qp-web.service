[Unit]
Description=Quarantine Package web app
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=simple
User=qp
Group=qp
SupplementaryGroups=docker
WorkingDirectory=/opt/quarantine-package
# Non-secret settings
Environment=NODE_ENV=production
Environment=QP_WEB_HOST=127.0.0.1
Environment=QP_WEB_PORT=8080
Environment=QP_WEB_TRUSTED_PROXIES=127.0.0.1
Environment=QP_RUN_PREFIX=qp
Environment=QP_RECEIPTS_DIR=/var/lib/quarantine-package/receipts
Environment=QP_WEB_STATE_FILE=/var/lib/quarantine-package/web-state.json
# S7: origin for absolute links in /r/<id>.md and /api/receipts/<id>.sarif (plain origin, no path).
# Without it the links in those exports are relative.
# Environment=QP_PUBLIC_URL=https://<your-dns-name>
# The model key only: a root-owned 0600 file, never a command line
EnvironmentFile=/etc/quarantine-package/env
ExecStart=/usr/bin/node src/web/server.js
Restart=on-failure
RestartSec=3
# Stop: SIGTERM interrupts running tasks; each CLI tears its task down within 10 s
KillSignal=SIGTERM
TimeoutStopSec=20
# The docker group is root-equivalent (README L-14); the rest is defence in depth.
NoNewPrivileges=yes
ProtectSystem=full
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/quarantine-package /opt/quarantine-package/state
CapabilityBoundingSet=
AmbientCapabilities=
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
LockPersonality=yes
RestrictSUIDSGID=yes
UMask=0077
# Future hardening (not enabled: each could break the docker CLI and needs a test VM):
# ProtectSystem=strict, PrivateDevices=yes, RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6,
# SystemCallArchitectures=native.

[Install]
WantedBy=multi-user.target
